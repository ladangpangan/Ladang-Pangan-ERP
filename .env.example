# Payment gateway (Midtrans) untuk landing page /jual-ayam-frozen
# Cara utama: isi lewat Dashboard > Landing Page Ayam Frozen (tersimpan di database,
# berlaku tanpa redeploy). Variabel di bawah ini hanya dipakai sebagai FALLBACK sebelum
# admin mengisi key lewat dashboard tersebut.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Set "true" hanya setelah menggunakan kunci PRODUCTION.
MIDTRANS_IS_PRODUCTION=false
