# Copy this file to `.env` and fill in real values before running docker compose.
# NEVER commit the real .env (secrets) to git.

NODE_ENV=production

# ---- Database (SQLite, primary store) ----
# Path inside the container; docker-compose mounts ./data -> /app/data so this persists.
DB_PATH=/app/data/erp.db

# ---- MongoDB (required: Better Auth login/session storage + durable SQLite backup) ----
# Use a MongoDB Atlas free-tier cluster (or self-hosted Mongo). Whitelist this VPS's public IP
# in Atlas Network Access, or use 0.0.0.0/0 only temporarily while testing.
# ATLAS_MONGO_URL takes priority over MONGO_URL if both are set.
ATLAS_MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/erp_prod?retryWrites=true&w=majority
MONGO_DB_NAME=erp_prod

# ---- Auth (Better Auth) ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_RANDOM_LONG_SECRET
BETTER_AUTH_URL=https://erp.yourdomain.id
APP_URL=https://erp.yourdomain.id

# ---- CORS ----
# Lock to your real domain in production (avoid "*").
CORS_ORIGINS=https://erp.yourdomain.id

# ---- Docker port binding ----
# Default (127.0.0.1) only exposes the app to Nginx running on the same host. Set to 0.0.0.0
# ONLY for a temporary pre-Nginx staging test reachable at http://<VPS-IP>:3000 (plain HTTP,
# no TLS) — switch back to 127.0.0.1 (or remove this line) before going to real production.
# APP_BIND_IP=0.0.0.0

# ---- AI assistant (optional) ----
# Only needed if you want the in-app AI assistant feature. Requires a valid Emergent LLM key;
# verify with Emergent whether it works from outside their platform before relying on it.
# EMERGENT_LLM_KEY=
# AI_MODEL=gpt-5.2
