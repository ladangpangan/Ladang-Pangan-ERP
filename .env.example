# Payment gateway (Midtrans) untuk landing page /jual-ayam-frozen
# Ambil kunci ini dari dashboard Midtrans Anda (Settings > Access Keys).
# Gunakan kunci SANDBOX terlebih dahulu untuk uji coba sebelum go-live.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Set "true" hanya setelah menggunakan kunci PRODUCTION.
MIDTRANS_IS_PRODUCTION=false
