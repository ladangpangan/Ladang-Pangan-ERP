# Copy this file to `.env` and fill in real values before running docker compose.
# NEVER commit the real .env (secrets) to git.

NODE_ENV=production

# ---- Database (SQLite, primary store) ----
# Path inside the container; docker-compose mounts ./data -> /app/data so this persists.
DB_PATH=/app/data/erp.db

# ---- MongoDB (required: Better Auth login/session storage + durable SQLite backup) ----
# Use a MongoDB Atlas free-tier cluster (or self-hosted Mongo). Whitelist this VPS's public IP
# in Atlas Network Access, or use 0.0.0.0/0 only temporarily while testing.
# ATLAS_MONGO_URL takes priority over MONGO_URL if both are set.
ATLAS_MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/erp_prod?retryWrites=true&w=majority
MONGO_DB_NAME=erp_prod

# ---- Auth (Better Auth) ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_RANDOM_LONG_SECRET
BETTER_AUTH_URL=https://erp.yourdomain.id
APP_URL=https://erp.yourdomain.id

# ---- CORS ----
# Lock to your real domain in production (avoid "*").
CORS_ORIGINS=https://erp.yourdomain.id

# ---- Docker port binding ----
# Default (127.0.0.1) only exposes the app to Nginx running on the same host. Set to 0.0.0.0
# ONLY for a temporary pre-Nginx staging test reachable at http://<VPS-IP>:3000 (plain HTTP,
# no TLS) — switch back to 127.0.0.1 (or remove this line) before going to real production.
# APP_BIND_IP=0.0.0.0
# Change the HOST-side port if 3000 is already taken by something else on a shared VPS (the
# container still listens on 3000 internally — only the host mapping changes).
# APP_HOST_PORT=3000

# ---- Session cookie security ----
# Login over plain HTTP (no TLS) needs this set to 0, otherwise the browser silently drops the
# session cookie (Secure attribute requires HTTPS) and every login bounces back to /login.
# Leave unset (secure cookies) once you're behind Nginx+HTTPS for real production.
# COOKIE_SECURE=0

# ---- AI assistant (optional) ----
# Only needed if you want the in-app AI assistant feature. Requires a valid Emergent LLM key;
# verify with Emergent whether it works from outside their platform before relying on it.
# EMERGENT_LLM_KEY=
# AI_MODEL=gpt-5.2

# ---- External agent integration (optional, e.g. Hermes) ----
# Lets an external AI agent call this app's existing REST API (read + write) as a service
# identity, instead of a browser session. Opt-in: leave unset to disable entirely — no behavior
# change until AGENT_API_KEY is set. Generate with: openssl rand -base64 32. NEVER paste the real
# value into chat/tickets; treat it like a password. See deploy/HERMES_INTEGRATION.md.
# AGENT_API_KEY=
# Role granted to that identity for every existing requireRole() check in the app (default admin
# if AGENT_API_KEY is set and this is left blank). Dial down to 'supervisor' or 'akuntan' for a
# more read-mostly integration.
# AGENT_ROLE=admin

# ---------------------------------------------------------------------------------------------
# Integrasi Productivity App (produktifitas.ladangpangan.id) — lihat deploy/INTEGRASI_PRODUCTIVITY.md
# Kosongkan INTEGRASI_RAHASIA dan INTEGRASI_TOKEN = integrasi mati. JANGAN tempel nilai asli di chat/GitHub.
# INTEGRASI_URL      = alamat penerima di Productivity App (jalur dalam server, jaringan Docker lpi-internal)
# INTEGRASI_RAHASIA  = rahasia tanda tangan, min. 16 karakter, SAMA dengan yang diisi di Productivity App
#                      (Pengaturan › Integrasi › ERP › Rahasia tanda tangan). Buat: openssl rand -hex 24
# INTEGRASI_TOKEN    = token tarik (Bearer), min. 16 karakter, SAMA dengan "Token tarik" di Productivity App
# INTEGRASI_MULAI    = (opsional) YYYY-MM-DD, data sebelum tanggal ini tidak dikirim. Bawaan: awal bulan saat pertama aktif
# INTEGRASI_UJI      = (opsional) 1 untuk staging: semua kabar bertanda uji (tidak dihitung ke target)
# ---------------------------------------------------------------------------------------------
# INTEGRASI_URL=http://produktivitas:3000/api/integrasi/erp
# INTEGRASI_RAHASIA=
# INTEGRASI_TOKEN=
# INTEGRASI_MULAI=
# INTEGRASI_UJI=
