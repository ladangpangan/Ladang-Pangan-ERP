/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Environment files (comprehensive coverage)
*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
*pyc*
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db
# SQLite runtime DB is NOT committed — production hydrates from MongoDB (Atlas) durable
# backups, and a truly-fresh install falls back to lib/db/seed-snapshot.json.
/data/erp.db
/data/*.db
/data/*.db-wal
/data/*.db-shm
/data/*.restore.tmp*
/data/.erp-backup-*.db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

memory/test_credentials.md

# Mobile development
android-sdk/node_modules/@next/swc-linux-arm64-musl/next-swc.linux-arm64-musl.node
node_modules/@next/swc-linux-arm64-gnu/next-swc.linux-arm64-gnu.node
node_modules/@next/swc-linux-arm64-musl/next-swc.linux-arm64-musl.node
# NOTE: .env is intentionally NOT ignored — Emergent deployment requires it committed and injects
# production secrets (MONGO_URL, APP_URL, etc.) at deploy time. Do not add real 3rd-party secrets here.
credentials.json
*.key
.credentials
# (Do NOT add .env / .env.* / *.env here — they must stay committed for Emergent deployment.)
